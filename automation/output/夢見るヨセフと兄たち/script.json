      "scenes": [
        {
          "id": "4-1",
          "text": "エジプトで、ヨセフは<br>いっしょうけんめい はたらきました。",
          "is_video": true
        },
        {
          "id": "4-2",
          "text": "どんなときも、かみさまに<br>おいのりを しました。",
          "is_video": false
        },
        {
          "id": "4-3",
          "text": "かみさまは、ヨセフを<br>たくさん たすけてくれました。",
          "is_video": false
        },
        {
          "id": "4-4",
          "text": "ヨセフは エジプトの<br>えらいひとに なりました。",
          "is_video": true
        }
      ]
    },
    {
      "id": "section-5",
      "title": "おにいさんたちとのさいかい",
      "scenes": [
        {
          "id": "5-1",
          "text": "ずっと あとになって、<br>おにいさんたちが エジプトへ<br>やってきました。",
          "is_video": true
        },
        {
          "id": "5-2",
          "text": "食べものが なくて、<br>こまっていたのです。",
          "is_video": false
        },
        {
          "id": "5-3",
          "text": "「ヨセフ、あのときは<br>ごめんなさい」",
          "is_video": true
        },
        {
          "id": "5-4",
          "text": "ヨセフは、おにいさんたちを<br>ゆるしてあげました。",
          "is_video": false
        },
        {
          "id": "5-5",
          "text": "「かみさまが、みんなを たすけるために<br>ぼくを ここへ よんだんだね」",
          "is_video": true
        }
      ]
    },
    {
