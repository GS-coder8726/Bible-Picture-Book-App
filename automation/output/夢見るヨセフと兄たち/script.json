      "scenes": [
        {
          "id": "1-1",
          "text": "むかしむかし、ヨセフという<br>おとこのこが いました。",
          "is_video": true
        },
        {
          "id": "1-2",
          "text": "おとうさんのヤコブは、<br>ヨセフが だいすきでした。",
          "is_video": false
        },
        {
          "id": "1-3",
          "text": "おとうさんは ヨセフに、<br>カラフルで きれいな ふくを<br>つくってあげました。",
          "is_video": true
        },
        {
          "id": "1-4",
          "text": "おにいさんたちは、それを見て<br>すこし やきもちを やきました。",
          "is_video": false
        }
      ]
    },
    {
      "id": "section-2",
      "title": "ヨセフのふしぎなゆめ",
      "scenes": [
        {
          "id": "2-1",
          "text": "あるよる、ヨセフは<br>ふしぎな ゆめを みました。",
          "is_video": true
        },
        {
          "id": "2-2",
          "text": "かみさまが、ヨセフに<br>とくべつな ゆめを<br>みせてくれたのです。",
          "is_video": false
        },
        {
          "id": "2-3",
          "text": "「ぼくの むぎのたばに、<br>みんなの たばが おじぎをしたんだよ」",
          "is_video": false
        },
        {
          "id": "2-4",
          "text": "ほしの ゆめも みました。<br>「おほしさまが ぼくに おじぎをしたよ」",
          "is_video": true
        },
        {
          "id": "2-5",
          "text": "おにいさんたちは、<br>もっと ぷんぷん<br>おこってしまいました。",
          "is_video": false
        }
      ]
    },
    {
      "id": "section-3",
      "title": "エジプトへ",
      "scenes": [
        {
          "id": "3-1",
          "text": "あるひ、おにいさんたちは<br>はたけで おしごとをしていました。",
