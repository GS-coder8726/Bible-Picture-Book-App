{
  "id": "calling_disciples",
  "title": "イエスさまと 12にんの でしたち",
  "sections": [
    {
      "id": "cover",
      "scenes": [
        {
          "scene_id": "0-1",
          "text": "イエスさまと\n12にんの でしたち"
        }
      ]
    },
    {
      "id": "section1",
      "title": "かみさまの おもい",
      "scenes": [
        {
          "scene_id": "1-1",
          "text": "かみさまは、おそらから<br>せかいを みて いました。"
        },
        {
          "scene_id": "1-2",
          "text": "「せかいの みんなに、<br>たいせつな ことを つたえよう」と おもいました。"
        },
        {
          "scene_id": "1-3",
          "text": "そこで、イエスさまは<br>うみの ほとりを あるき はじめました。"
        },
        {
          "scene_id": "1-4",
          "text": "おてつだいを してくれる<br>おともだちを さがして いるのです。"
        }
      ]
    },
    {
      "id": "section2",
      "title": "ペテロと アンデレ",
      "scenes": [
        {
          "scene_id": "2-1",
          "text": "うみには、ペテロと アンデレという<br>きょうだいが いました。"
        },
        {
          "scene_id": "2-2",
          "text": "ふたりは いっしょうけんめい、<br>あみを なげて います。"
        },
        {
          "scene_id": "2-3",
          "text": "おさかなを とる おしごとを<br>して いるのです。"
        },
        {
          "scene_id": "2-4",
          "text": "だけど、きょうは<br>なかなか おさかなが とれません。"
        }
      ]
    },
    {
      "id": "section3",
      "title": "わたしに ついて きなさい",
      "scenes": [
        {
          "scene_id": "3-1",
          "text": "イエスさまは、<br>ふたりに こえを かけました。"
        },
        {
          "scene_id": "3-2",
          "text": "「わたしに ついて きなさい。」"
        },
        {
          "scene_id": "3-3",
          "text": "「にんげんを とる りょうしに<br>して あげよう。」"
        },
        {
          "scene_id": "3-4",
          "text": "すると ふたりは、すぐに あみを おいて、<br>イエスさまに ついて いきました。"
        }
      ]
    },
    {
      "id": "section4",
      "title": "ヤコブと ヨハネ",
      "scenes": [
        {
          "scene_id": "4-1",
          "text": "すこし あるくと、<br>また べつの ふねが ありました。"
        },
        {
          "scene_id": "4-2",
          "text": "ヤコブと ヨハネという<br>きょうだいが いました。"
        },
        {
          "scene_id": "4-3",
          "text": "ふたりは、やぶれた あみを<br>きれいに なおして います。"
        },
        {
          "scene_id": "4-4",
          "text": "とても しんせつで、<br>げんきな おとこのこたち です。"
        }
      ]
    },
    {
      "id": "section5",
      "title": "いっしょに いこう",
      "scenes": [
        {
          "scene_id": "5-1",
          "text": "イエスさまは、この ふたりにも<br>こえを かけました。"
        },
        {
          "scene_id": "5-2",
          "text": "ヤコブと ヨハネは、イエスさまの<br>やさしい かおを みて うれしく なりました。"
        },
        {
          "scene_id": "5-3",
          "text": "おとうさんに 「いってきます！」と いって、<br>ふねを おりました。"
        },
        {
          "scene_id": "5-4",
          "text": "イエスさまと いっしょに、<br>とことこ あるき はじめました。"
        }
      ]
    },
    {
      "id": "section6",
      "title": "12にんの でしたち",
      "scenes": [
        {
          "scene_id": "6-1",
          "text": "こうして、イエスさまの まわりに<br>おともだちが ふえて いきました。"
        },
        {
          "scene_id": "6-2",
          "text": "ぜんぶで 12にんの たいせつな<br>おともだちが あつまりました。"
        },
        {
          "scene_id": "6-3",
          "text": "みんな、イエスさまの ことが<br>だいすきです。"
        },
        {
          "scene_id": "6-4",
          "text": "みんなで いっしょに、かみさまの<br>おはなしを つたえに いきます。"
        },
        {
          "scene_id": "6-5",
          "text": "さあ、どんな わくわくする<br>おはなしが はじまるのかな？"
        }
      ]
    }
  ]
}
