{
  "id": "pentecost",
  "title": "ペンテコステの ひ",
  "sections": [
    {
      "sectionId": 1,
      "scenes": [
        {
          "id": "1-1",
          "text": "イエスさまが おそらに のぼっていくよ。"
        },
        {
          "id": "1-2",
          "text": "「わたしは いつも いっしょに いるよ。」"
        },
        {
          "id": "1-3",
          "text": "「かみさまの ちからを おくるから、まっていてね。」"
        },
        {
          "id": "1-4",
          "text": "おでしたちは、そらを みあげて おみおくりをしたよ。"
        }
      ]
    },
    {
      "sectionId": 2,
      "scenes": [
        {
          "id": "2-1",
          "text": "おでしたちは おへやに あつまったよ。"
        },
        {
          "id": "2-2",
          "text": "みんなで おいのりをして まっていたんだ。"
        },
        {
          "id": "2-3",
          "text": "「かみさま、イエスさまの おやくそくは いつかな？」"
        },
        {
          "id": "2-4",
          "text": "みんな なかよく、おいのり していたよ。"
        }
      ]
    },
    {
      "sectionId": 3,
      "scenes": [
        {
          "id": "3-1",
          "text": "あるひ、とつぜん つよい かぜが ふいてきた！"
        },
        {
          "id": "3-2",
          "text": "ビューッ！ おへやの なかに かぜの おとが ひびくよ。"
        },
        {
          "id": "3-3",
          "text": "すると、ちいさな ほのおが みえてきたよ。"
        },
        {
          "id": "3-4",
          "text": "ほのおは、みんなの あたまの うえに おりてきたんだ。"
        },
        {
          "id": "3-5",
          "text": "でも、あつくないよ。<br>これは「せいれい」という かみさまの ちからだよ。"
        }
      ]
    },
    {
      "sectionId": 4,
      "scenes": [
        {
          "id": "4-1",
          "text": "みんなの こころが ぽかぽか あたたかくなったよ。"
        },
        {
          "id": "4-2",
          "text": "こわがりだった おでしたちも、ゆうきが わいてきたんだ。"
        },
        {
          "id": "4-3",
          "text": "「かみさま、ありがとう！」"
        },
        {
          "id": "4-4",
          "text": "みんな、とっても うれしそう！"
        }
      ]
    },
    {
      "sectionId": 5,
      "scenes": [
        {
          "id": "5-1",
          "text": "おでしたちは、おそとに でて おはなしを はじめたよ。"
        },
        {
          "id": "5-2",
          "text": "あれ？ いろんな くにの ことばで おはなし しているよ！"
        },
        {
          "id": "5-3",
          "text": "まちの ひとたちは、びっくり！"
        },
        {
          "id": "5-4",
          "text": "「ぼくたちの くにの ことばで おはなし している！」"
        },
        {
          "id": "5-5",
          "text": "かみさまの ちからって、すごいね！"
        }
      ]
    },
    {
      "sectionId": 6,
      "scenes": [
        {
          "id": "6-1",
          "text": "ペテロさんが、みんなに イエスさまの ことを おはなししたよ。"
        },
        {
          "id": "6-2",
          "text": "「イエスさまは、みんなの ことを あいしているよ！」"
        },
        {
          "id": "6-3",
          "text": "たくさんの ひとが、かみさまを だいすきに なったよ。"
        },
        {
          "id": "6-4",
          "text": "こうして、はじめの きょうかいが できたんだ。<br>みんな えがおだね！"
        }
      ]
    }
  ]
}