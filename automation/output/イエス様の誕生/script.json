{
  "id": "birth_of_jesus",
  "title": "いえすさまのおたんじょう",
  "sections": [
    {
      "id": "cover",
      "title": "カバー",
      "scenes": [
        {
          "id": "0-1",
          "text": "いえすさまの おたんじょう"
        }
      ]
    },
    {
      "id": "section1",
      "title": "まりあとよせふのたび",
      "scenes": [
        {
          "id": "1-1",
          "text": "むかしむかし、まりあという やさしい おんなの人が いました。"
        },
        {
          "id": "1-2",
          "text": "ある日、てんしが やってきて 言いました。<br>「かみさまの こどもが うまれますよ。」"
        },
        {
          "id": "1-3",
          "text": "まりあと よせふは、とおくの まちへ おでかけを しました。"
        },
        {
          "id": "1-4",
          "text": "ろばさんに のって、ことこと。<br>よるの みちを すすみます。"
        },
        {
          "id": "1-5",
          "text": "やっとの おもいで、べつれへむ という まちに つきました。"
        }
      ]
    },
    {
      "id": "section2",
      "title": "うまごやへ",
      "scenes": [
        {
          "id": "2-1",
          "text": "まちは 人で いっぱいで、とまる おうちが ありません。"
        },
        {
          "id": "2-2",
          "text": "「どうしよう、あかちゃんが うまれそうなのに。」"
        },
        {
          "id": "2-3",
          "text": "やどやの 人が 言いました。<br>「うまごや なら、あいていますよ。」"
        },
        {
          "id": "2-4",
          "text": "２人は ほっとして、うまごやへ むかいました。"
        }
      ]
    },
    {
      "id": "section3",
      "title": "いえすさまのたんじょう",
      "scenes": [
        {
          "id": "3-1",
          "text": "よるに なりました。<br>おほしさまが きらきら ひかっています。"
        },
        {
          "id": "3-2",
          "text": "うまごやで、かわいい あかちゃんが うまれました。<br>おなまえは「いえすさま」です。"
        },
        {
          "id": "3-3",
          "text": "まりあは、いえすさまを やさしく だっこしました。"
        },
        {
          "id": "3-4",
          "text": "べっどが ないので、かいばおけの わらの 上に ねかせました。"
        },
        {
          "id": "3-5",
          "text": "うしさんや ろばさんも、あかちゃんを みまもっています。"
        }
      ]
    },
    {
      "id": "section4",
      "title": "ひつじかいたち",
      "scenes": [
        {
          "id": "4-1",
          "text": "そのころ、のっぱらで ひつじかいたちが ひつじの おせわを していました。"
        },
        {
          "id": "4-2",
          "text": "すると、ぴかーっと ひかって、てんしが あらわれました。"
        },
        {
          "id": "4-3",
          "text": "「きょう、いえすさまが うまれましたよ。<br>おほしさまを みて ごらん。」"
        },
        {
          "id": "4-4",
          "text": "ひつじかいたちは びっくりして、あかちゃんに あいに いきました。"
        }
      ]
    },
    {
      "id": "section5",
      "title": "はかせたち",
      "scenes": [
        {
          "id": "5-1",
          "text": "とおくの くにの、はかせたちも おおきな ほしを みつけました。"
        },
        {
          "id": "5-2",
          "text": "「すばらしい あかちゃんが うまれたんだ！」<br>らくだに のって、しゅっぱつです。"
        },
        {
          "id": "5-3",
          "text": "おほしさまは、いえすさまの いる うまごやを おしえてくれました。"
        }
      ]
    },
    {
      "id": "section6",
      "title": "みんなでおいわい",
      "scenes": [
        {
          "id": "6-1",
          "text": "みんな、うまごやに あつまりました。"
        },
        {
          "id": "6-2",
          "text": "はかせたちは、たいせつな たからものを ぷれぜんと しました。"
        },
        {
          "id": "6-3",
          "text": "「いえすさま、おめでとう！」<br>みんな ほっこり えがおです。"
        },
        {
          "id": "6-4",
          "text": "かみさまは、みんなを あいして いえすさまを おくって くれました。"
        },
        {
          "id": "6-5",
          "text": "みんなの こころが、あたたかい ひかりで いっぱいになりました。"
        }
      ]
    }
  ]
}
