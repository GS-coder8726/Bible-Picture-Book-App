{
  "id": "noahs_ark",
  "title": "ノアのはこぶね",
  "sections": [
    {
      "id": "1",
      "title": "かみさまとノア",
      "parts": [
        {
          "id": "1-1",
          "text": "むかしむかし、ノアという おじいさんが いました。"
        },
        {
          "id": "1-2",
          "text": "ノアは とても やさしくて、かみさまが だいすきでした。"
        },
        {
          "id": "1-3",
          "text": "かみさまは、ノアに いいました。<br>「おおきな ふねを つくりなさい」"
        },
        {
          "id": "1-4",
          "text": "ノアは かみさまの おやくそくを まもって、ふねを つくりはじめました。"
        }
      ]
    },
    {
      "id": "2",
      "title": "ふねをつくる",
      "parts": [
        {
          "id": "2-1",
          "text": "トントン、カンカン。<br>ノアは ひとりで、いっしょうけんめい きを きります。"
        },
        {
          "id": "2-2",
          "text": "まちの ひとたちや かぞくに わらわれても、ノアは とても おおきな ふねを つくりました。"
        },
        {
          "id": "2-3",
          "text": "とうとう、はこぶねが かんせいしました！"
        }
      ]
    },
    {
      "id": "3",
      "title": "どうぶつたちがやってくる",
      "parts": [
        {
          "id": "3-1",
          "text": "ふねが かんせいすると、ふしぎな ことが おきました。"
        },
        {
          "id": "3-2",
          "text": "もりから たくさんの どうぶつたちが やってきました！"
        },
        {
          "id": "3-3",
          "text": "ゾウさん、ライオンさん、ウサギさん。<br>みんな、オスと メスが １ぴきずつ です。"
        },
        {
          "id": "3-4",
          "text": "チュンチュン、ことりたちも とんで きました。"
        },
        {
          "id": "3-5",
          "text": "どうぶつたちは じゅんばんに、ふねの なかへ はいります。"
        }
      ]
    },
    {
      "id": "4",
      "title": "おおあめ",
      "parts": [
        {
          "id": "4-1",
          "text": "どうぶつたちが はいると、ポツリポツリと あめが ふってきました。"
        },
        {
          "id": "4-2",
          "text": "あめは だんだん つよくなり、ザーザーふりに なりました。"
        },
        {
          "id": "4-3",
          "text": "おおきな みずたまりが できて、うみの ようです。"
        },
        {
          "id": "4-4",
          "text": "ふねは、チャプチャプと みずに うかびました。"
        },
        {
          "id": "4-5",
          "text": "かみさまが、ノアたちを まもって くれています。"
        }
      ]
    },
    {
      "id": "5",
      "title": "あめがやむ",
      "parts": [
        {
          "id": "5-1",
          "text": "ずーっと ふっていた あめが、ようやく やみました。"
        },
        {
          "id": "5-2",
          "text": "ノアは、しろい ハトを おそらに とばしました。"
        },
        {
          "id": "5-3",
          "text": "ハトは、オリーブの はっぱを くわえて もどってきました。"
        },
        {
          "id": "5-4",
          "text": "「やったあ！ じめんが みえたぞ！」<br>みんな おおよろこびです。"
        }
      ]
    },
    {
      "id": "6",
      "title": "にじのおやくそく",
      "parts": [
        {
          "id": "6-1",
          "text": "ノアと どうぶつたちは、ふねから そとへ でました。"
        },
        {
          "id": "6-2",
          "text": "おひさまが キラキラと、みんなを てらします。"
        },
        {
          "id": "6-3",
          "text": "おそらに、とても おおきな なないろの にじが かかりました。"
        },
        {
          "id": "6-4",
          "text": "「これは、もう ずっと みんなを まもる という おやくそくだよ」"
        },
        {
          "id": "6-5",
          "text": "ノアたちは かみさまに「ありがとう」と いいました。"
        }
      ]
    }
  ]
}
