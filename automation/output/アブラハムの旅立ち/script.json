        }
      ]
    },
    {
      "id": "1",
      "title": "かみさまの おつげ",
      "parts": [
        {
          "id": "1-1",
          "text": "むかしむかし、アブラムという おじいさんが いました。",
          "is_video": false
        },
        {
          "id": "1-2",
          "text": "かみさまは アブラムに いいました。<br>「あなたの うまれた くにを はなれなさい。」",
          "is_video": false
        },
        {
          "id": "1-3",
          "text": "「わたしが みせる あたらしい 土地へ いきなさい。」",
          "is_video": false
        },
        {
          "id": "1-4",
          "text": "「そうすれば、あなたを おおきな くにに します。」",
          "is_video": true
        }
      ]
    },
    {
      "id": "2",
      "title": "たびの じゅんび",
      "parts": [
        {
          "id": "2-1",
          "text": "アブラムは、かみさまの ことばを しんじました。",
          "is_video": true
        },
        {
          "id": "2-2",
          "text": "おくさんの サライに いいました。<br>「かみさまが おっしゃる 土地へ いこう！」",
          "is_video": true
        },
        {
          "id": "2-3",
          "text": "おいの ロトも いっしょに いくことに なりました。",
          "is_video": false
        },
        {
          "id": "2-4",
          "text": "みんなで にもつを まとめて、たびの じゅんびを します。",
          "is_video": true
        }
      ]
    },
    {
      "id": "3",
      "title": "しゅっぱつ",
      "parts": [
        {
          "id": "3-1",
          "text": "たくさんの ひつじや うしも いっしょです。",
          "is_video": false
        },
        {
          "id": "3-2",
          "text": "アブラムたちは、とおくを めざして あるきだしました。",
          "is_video": true
        },
        {
          "id": "3-3",
          "text": "どこへ いくのか、まだ わかりません。",
          "is_video": false
        },
        {
          "id": "3-4",
          "text": "でも、アブラムは かみさまを しんじて いました。",
          "is_video": true
        },
        {
          "id": "3-5",
          "text": "てんとを はって、よるは ぐっすり ねむりました。",
          "is_video": false
        }
      ]
    },
    {
      "id": "4",
      "title": "ながい みちのり",
      "parts": [
        {
          "id": "4-1",
          "text": "あつい さばくの みちも ありました。",
          "is_video": true
        },
        {
          "id": "4-2",
          "text": "おおきな やまも こえました。",
          "is_video": false
        },
        {
          "id": "4-3",
          "text": "かみさまは いつも アブラムたちを まもって くれました。",
          "is_video": true
        },
        {
          "id": "4-4",
          "text": "ときどき、みずが なくて こまった ことも ありました。",
          "is_video": false
        }
      ]
    },
    {
      "id": "5",
      "title": "ほしぞらの やくそく",
      "parts": [
        {
          "id": "5-1",
          "text": "ある よる、かみさまが アブラムに いいました。<br>「よぞらの ほしを みてごらん。」",
          "is_video": false
        },
        {
          "id": "5-2",
          "text": "「あなたの こどもたちは、この ほしのように たくさんになるよ。」",
          "is_video": true
        },
        {
          "id": "5-3",
          "text": "アブラムは、おどろいて ほしぞらを みあげました。",
          "is_video": false
        },
        {
          "id": "5-4",
          "text": "「かみさま、ありがとうございます。」",
          "is_video": true
        }
      ]
    },
    {
      "id": "6",
      "title": "やくそくの 土地",
      "parts": [
        {
          "id": "6-1",
          "text": "ながい ながい たびを つづけました。",
          "is_video": false
        },
        {
          "id": "6-2",
          "text": "そして ついに、カナンの 土地に つきました。",
          "is_video": true
        },
        {
          "id": "6-3",
          "text": "「ここが、かみさまの やくそくの 土地だ！」",
          "is_video": false
        },
        {
          "id": "6-4",
          "text": "アブラムは、かみさまに ありがとうのおいのりを しました。",
          "is_video": true
        }
      ]
    }
  ]
}
