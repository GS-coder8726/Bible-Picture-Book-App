{
  "id": "good_samaritan",
  "title": "よき サマリアびと",
  "sections": [
    {
      "section_id": 1,
      "title": "たびびと",
      "parts": [
        {
          "id": "1-1",
          "text": "あるひ、ひとりの おとこのひとが<br>みちを あるいていました。"
        },
        {
          "id": "1-2",
          "text": "ときどき けものが でる<br>すこし こわい みちです。"
        },
        {
          "id": "1-3",
          "text": "「きをつけて いこう」<br>おとこのひとは いそぎました。"
        },
        {
          "id": "1-4",
          "text": "ところが、わるいひとたちが<br>いきなり とびだしてきました！"
        }
      ]
    },
    {
      "section_id": 2,
      "title": "わるいひとたち",
      "parts": [
        {
          "id": "2-1",
          "text": "「もっているものを おいていけ！」<br>わるいひとたちは おそいかかりました。"
        },
        {
          "id": "2-2",
          "text": "おとこのひとは けがをして<br>たおれてしまいました。"
        },
        {
          "id": "2-3",
          "text": "わるいひとたちは にげていき<br>おとこのひとは ひとりぼっちです。"
        },
        {
          "id": "2-4",
          "text": "「だれか たすけて…」<br>おとこのひとは ないていました。"
        }
      ]
    },
    {
      "section_id": 3,
      "title": "さいしさま",
      "parts": [
        {
          "id": "3-1",
          "text": "そこへ、えらい さいしさまが<br>とおりかかりました。"
        },
        {
          "id": "3-2",
          "text": "「あ、ひとが たおれているぞ」<br>さいしさまは きづきました。"
        },
        {
          "id": "3-3",
          "text": "でも、さいしさまは<br>みないふりをして いってしまいました。"
        },
        {
          "id": "3-4",
          "text": "おとこのひとは どんどん<br>くるしく なっていきます。"
        }
      ]
    },
    {
      "section_id": 4,
      "title": "おいのりをするひと",
      "parts": [
        {
          "id": "4-1",
          "text": "つぎに、おいのりをする ひとが<br>とおりかかりました。"
        },
        {
          "id": "4-2",
          "text": "「どうしたんだろう？」<br>そのひとも きづきました。"
        },
        {
          "id": "4-3",
          "text": "でも、かかわりたくなくて<br>いそいで にげてしまいました。"
        },
        {
          "id": "4-4",
          "text": "「だれも たすけてくれない…」<br>おとこのひとは かなしみました。"
        }
      ]
    },
    {
      "section_id": 5,
      "title": "サマリアのひと",
      "parts": [
        {
          "id": "5-1",
          "text": "そのとき、サマリアのくにの ひとが<br>ロバにのって やってきました。"
        },
        {
          "id": "5-2",
          "text": "サマリアのひとは たおれているひとを<br>みると、あわてて ロバから おりました。"
        },
        {
          "id": "5-3",
          "text": "「だいじょうぶですか！？」<br>やさしく こえを かけました。"
        },
        {
          "id": "5-4",
          "text": "そして、きずに おくすりをぬって<br>ほうたいを まいてくれました。"
        }
      ]
    },
    {
      "section_id": 6,
      "title": "ほんとうのおともだち",
      "parts": [
        {
          "id": "6-1",
          "text": "サマリアのひとは けがをしたひとを<br>じぶんの ロバに のせました。"
        },
        {
          "id": "6-2",
          "text": "そして、やすめる やどやまで<br>つれていって くれました。"
        },
        {
          "id": "6-3",
          "text": "「このひとを おねがいします」<br>やどやの ひとに おかねを わたしました。"
        },
        {
          "id": "6-4",
          "text": "「もし おかねが たりなかったら<br>あとで わたしが はらいます」"
        },
        {
          "id": "6-5",
          "text": "こまったひとを たすける ひとが<br>ほんとうの おともだちです。"
        }
      ]
    }
  ]
}