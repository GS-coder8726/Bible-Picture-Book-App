{
  "id": "paradise-lost",
  "title": "しつらくえん",
  "sections": [
    {
      "id": "cover",
      "scenes": [
        {
          "id": "0-1",
          "text": "しつらくえん<br>〜かみさまとのおやくそく〜",
          "is_video": false,
          "is_god_scene": false
        }
      ]
    },
    {
      "id": "section1",
      "scenes": [
        {
          "id": "1-1",
          "text": "エデンの そのは とても きれいな ところでした。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "1-2",
          "text": "おはなが さいていて、<br>どうぶつたちが あそんでいます。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "1-3",
          "text": "アダムとエバは、いつも なかよしです。",
          "is_video": false,
          "is_god_scene": false
        },
        {
          "id": "1-4",
          "text": "かみさまも、ふたりを みて<br>にこにこ していました。",
          "is_video": false,
          "is_god_scene": true
        }
      ]
    },
    {
      "id": "section2",
      "scenes": [
        {
          "id": "2-1",
          "text": "かみさまは、ふたりに おやくそくを しました。",
          "is_video": false,
          "is_god_scene": true
        },
        {
          "id": "2-2",
          "text": "「あの きの みだけは、<br>たべては いけませんよ」",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "2-3",
          "text": "アダムとエバは、「はい」と おへんじ しました。",
          "is_video": false,
          "is_god_scene": false
        },
        {
          "id": "2-4",
          "text": "ふたりは まいにち、たのしく くらしていました。",
          "is_video": true,
          "is_god_scene": false
        }
      ]
    },
    {
      "id": "section3",
      "scenes": [
        {
          "id": "3-1",
          "text": "あるひ、へびが エバに はなしかけました。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "3-2",
          "text": "「あの きの みは、とても おいしいよ」",
          "is_video": false,
          "is_god_scene": false
        },
        {
          "id": "3-3",
          "text": "エバは、きの みを じっと みつめました。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "3-4",
          "text": "どんな あじが するのかな？",
          "is_video": false,
          "is_god_scene": false
        }
      ]
    },
    {
      "id": "section4",
      "scenes": [
        {
          "id": "4-1",
          "text": "エバは、きの みを ひとつ とりました。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "4-2",
          "text": "そして、ぱくりと たべてしまいました。",
          "is_video": false,
          "is_god_scene": false
        },
        {
          "id": "4-3",
          "text": "「アダムも たべてみて」",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "4-4",
          "text": "アダムも、きの みを ぱくり。",
          "is_video": false,
          "is_god_scene": false
        },
        {
          "id": "4-5",
          "text": "そのとき、ふたりは どきっ！と しました。",
          "is_video": true,
          "is_god_scene": false
        }
      ]
    },
    {
      "id": "section5",
      "scenes": [
        {
          "id": "5-1",
          "text": "かみさまとの おやくそくを<br>やぶってしまったのです。",
          "is_video": false,
          "is_god_scene": false
        },
        {
          "id": "5-2",
          "text": "ふたりは、こわくなって かくれました。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "5-3",
          "text": "「アダム、エバ、どこに いるのですか？」",
          "is_video": false,
          "is_god_scene": true
        },
        {
          "id": "5-4",
          "text": "ふたりは、ごめんなさいと ないています。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "5-5",
          "text": "かみさまは、とても かなしそうでした。",
          "is_video": false,
          "is_god_scene": true
        }
      ]
    },
    {
      "id": "section6",
      "scenes": [
        {
          "id": "6-1",
          "text": "かみさまは、ふたりに かわの おようふくを<br>くれました。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "6-2",
          "text": "ふたりを まもる ためです。",
          "is_video": false,
          "is_god_scene": false
        },
        {
          "id": "6-3",
          "text": "アダムとエバは、<br>エデンの そのを でることに なりました。",
          "is_video": true,
          "is_god_scene": false
        },
        {
          "id": "6-4",
          "text": "でも、かみさまは<br>ずっと ふたりを みまもっています。",
          "is_video": false,
          "is_god_scene": true
        }
      ]
    }
  ]
}