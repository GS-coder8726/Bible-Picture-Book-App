{
  "id": "five_loaves",
  "title": "5つの パンと 2ひきの さかな",
  "sections": [
    {
      "id": "section0",
      "title": "カバー",
      "parts": [
        {
          "id": "0-1",
          "text": "5つの パンと<br>2ひきの さかな",
          "is_video": false
        }
      ]
    },
    {
      "id": "section1",
      "title": "イエスさまのおはなし",
      "parts": [
        {
          "id": "1-1",
          "text": "あるひ、イエスさまが<br>おはなしを していました。",
          "is_video": true
        },
        {
          "id": "1-2",
          "text": "「みんな、かみさまは<br>いつも みてくれていますよ」",
          "is_video": false
        },
        {
          "id": "1-3",
          "text": "たくさん の ひとが<br>あつまって きました。",
          "is_video": true
        },
        {
          "id": "1-4",
          "text": "おとなも こどもも<br>みんな むちゅう です。",
          "is_video": false
        }
      ]
    },
    {
      "id": "section2",
      "title": "ゆうぐれと おなか",
      "parts": [
        {
          "id": "2-1",
          "text": "おひさまが しずんで<br>ゆうがたに なりました。",
          "is_video": true
        },
        {
          "id": "2-2",
          "text": "ぐうう。<br>みんな おなかが すいてきました。",
          "is_video": false
        },
        {
          "id": "2-3",
          "text": "「イエスさま、みんな<br>おなかが ぺこぺこ です」",
          "is_video": true
        },
        {
          "id": "2-4",
          "text": "おでしたちが<br>しんぱい して いました。",
          "is_video": false
        }
      ]
    },
    {
      "id": "section3",
      "title": "おとこのこの おべんとう",
      "parts": [
        {
          "id": "3-1",
          "text": "そのとき、ひとりの<br>おとこのこが きました。",
          "is_video": true
        },
        {
          "id": "3-2",
          "text": "「ぼくの おべんとう、<br>つかってください！」",
          "is_video": false
        },
        {
          "id": "3-3",
          "text": "かごの なかには<br>5つの パンが ありました。",
          "is_video": true
        },
        {
          "id": "3-4",
          "text": "そして、ちいさな さかなが<br>2ひき ありました。",
          "is_video": false
        },
        {
          "id": "3-5",
          "text": "「でも、こんなに たくさんの<br>ひとには たりないよ…」",
          "is_video": true
        }
      ]
    },
    {
      "id": "section4",
      "title": "イエスさまの おいのり",
      "parts": [
        {
          "id": "4-1",
          "text": "イエスさまは<br>にっこり ほほえみました。",
          "is_video": false
        },
        {
          "id": "4-2",
          "text": "「ありがとう。<br>さあ、みんな すわりなさい」",
          "is_video": true
        },
        {
          "id": "4-3",
          "text": "イエスさまは パンと さかなを<br>てに とりました。",
          "is_video": false
        },
        {
          "id": "4-4",
          "text": "そして、おそらを みあげて<br>かみさまに おいのり しました。",
          "is_video": true
        },
        {
          "id": "4-5",
          "text": "かみさまは いつも<br>みんなを まもっています。",
          "is_video": false
        }
      ]
    },
    {
      "id": "section5",
      "title": "わけあう きせき",
      "parts": [
        {
          "id": "5-1",
          "text": "イエスさまが パンを<br>ちぎって わたすと…",
          "is_video": true
        },
        {
          "id": "5-2",
          "text": "ふしぎな ことに<br>パンが どんどん ふえていきます。",
          "is_video": false
        },
        {
          "id": "5-3",
          "text": "さかなも たくさん<br>ふえて いきました。",
          "is_video": true
        },
        {
          "id": "5-4",
          "text": "おでしたちが<br>みんなに くばりました。",
          "is_video": false
        }
      ]
    },
    {
      "id": "section6",
      "title": "おなかいっぱい",
      "parts": [
        {
          "id": "6-1",
          "text": "「わあ、おいしい！」<br>みんな えがお です。",
          "is_video": true
        },
        {
          "id": "6-2",
          "text": "5せん にん も の ひとが<br>おなかいっぱい たべました。",
          "is_video": false
        },
        {
          "id": "6-3",
          "text": "あまった パンを<br>かごに あつめると…",
          "is_video": true
        },
        {
          "id": "6-4",
          "text": "なんと、12こ の かごが<br>いっぱい に なりました！",
          "is_video": false
        },
        {
          "id": "6-5",
          "text": "かみさま、イエスさま、<br>ありがとう。",
          "is_video": true
        }
      ]
    }
  ]
}
