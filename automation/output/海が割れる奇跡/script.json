{
  "id": "parting_of_the_sea",
  "title": "うみが われる きせき",
  "sections": [
    {
      "section_id": "0",
      "title": "カバー",
      "parts": [
        {
          "id": "0-1",
          "text": "うみが われる きせき",
          "is_video": false
        }
      ]
    },
    {
      "section_id": "1",
      "title": "えじぷとをでる",
      "parts": [
        {
          "id": "1-1",
          "text": "もーせと ひとびとは えじぷとを 出発しました。",
          "is_video": true
        },
        {
          "id": "1-2",
          "text": "「かみさまが まもってくださるよ」<br>もーせは みんなに いいました。",
          "is_video": false
        },
        {
          "id": "1-3",
          "text": "ひるは くもの はしらが あんない してくれました。",
          "is_video": true
        },
        {
          "id": "1-4",
          "text": "よるは ほのおの はしらが てらしてくれました。",
          "is_video": true
        }
      ]
    },
    {
      "section_id": "2",
      "title": "うみと ぐんたい",
      "parts": [
        {
          "id": "2-1",
          "text": "ひとびとが あるいていくと、<br>おおきな うみに ぶつかりました。",
          "is_video": false
        },
        {
          "id": "2-2",
          "text": "そのとき、うしろから えじぷとの ぐんたいが おってきました！",
          "is_video": true
        },
        {
          "id": "2-3",
          "text": "「どうしよう！ にげみちが ないよ！」<br>ひとびとは こわがって なきだしました。",
          "is_video": true
        },
        {
          "id": "2-4",
          "text": "もーせは 「しんぱい しないで。かみさまが たすけてくれる」と いいました。",
          "is_video": false
        }
      ]
    },
    {
      "section_id": "3",
      "title": "かみさまの おつげ",
      "parts": [
        {
          "id": "3-1",
          "text": "かみさまは もーせに おはなしされました。",
          "is_video": false
        },
        {
          "id": "3-2",
          "text": "「つえを あげて、うみに むかって のばしなさい」",
          "is_video": false
        },
        {
          "id": "3-3",
          "text": "もーせは かみさまの いうとおりに しました。",
          "is_video": true
        },
        {
          "id": "3-4",
          "text": "つえを うみに むけて たかく あげました。",
          "is_video": false
        }
      ]
    },
    {
      "section_id": "4",
      "title": "うみが われる",
      "parts": [
        {
          "id": "4-1",
          "text": "すると、つよい かぜが ふいてきました。",
          "is_video": true
        },
        {
          "id": "4-2",
          "text": "ごーっ！ という おとと ともに、<br>うみの みずが 動きはじめました。",
          "is_video": true
        },
        {
          "id": "4-3",
          "text": "なんと、おおきな うみが まっぷたつに われたのです！",
          "is_video": true
        },
        {
          "id": "4-4",
          "text": "うみの なかに、かわいた みちが できました。",
          "is_video": false
        },
        {
          "id": "4-5",
          "text": "みぎと ひだりには、みずの かべが できました。",
          "is_video": true
        }
      ]
    },
    {
      "section_id": "5",
      "title": "うみを わたる",
      "parts": [
        {
          "id": "5-1",
          "text": "「さあ、みんな いそいで わたろう！」",
          "is_video": false
        },
        {
          "id": "5-2",
          "text": "ひとびとは びっくりしながらも、<br>うみの なかの みちを あるきました。",
          "is_video": true
        },
        {
          "id": "5-3",
          "text": "おとなも こどもも、<br>どうぶつたちも いっしょです。",
          "is_video": false
        },
        {
          "id": "5-4",
          "text": "むこうの きしまで、<br>みんな ぶじに わたることが できました。",
          "is_video": false
        }
      ]
    },
    {
      "section_id": "6",
      "title": "かみさまの たすけ",
      "parts": [
        {
          "id": "6-1",
          "text": "えじぷとの ぐんたいも うみの みちを おってきました。",
          "is_video": true
        },
        {
          "id": "6-2",
          "text": "でも、かみさまが うみの みずを もとに もどしました。",
          "is_video": false
        },
        {
          "id": "6-3",
          "text": "ざぶーん！<br>えじぷとの ぐんたいは なみに のまれて しまいました。",
          "is_video": true
        },
        {
          "id": "6-4",
          "text": "「わあ、かみさま ありがとう！」<br>みんなは よろこんで うたいました。",
          "is_video": false
        },
        {
          "id": "6-5",
          "text": "かみさまは いつでも みんなを<br>まもって くださるのです。",
          "is_video": false
        }
      ]
    }
  ]
}